{
  "baseUrl": "http://127.0.0.1:4173",
  "server": {
    "command": "node",
    "args": ["node_modules/vite/bin/vite.js", "preview", "--host", "127.0.0.1", "--port", "4173", "--strictPort"],
    "cwd": ".",
    "readyPath": "/"
  },
  "pages": [
    {
      "id": "paper-template-home",
      "path": "/",
      "states": [
        {
          "id": "initial",
          "actions": [
            { "type": "waitFor", "selector": "h1", "state": "visible" }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ":root", "property": "--color-accent", "equals": "#276b54" }
      ]
    }
  ]
}
