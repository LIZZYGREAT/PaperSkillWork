{
  "baseUrl": "http://127.0.0.1:4175",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "bundle",
      "--host",
      "127.0.0.1",
      "--port",
      "4175",
      "--strictPort"
    ],
    "cwd": "../../../reusable-kit/demo",
    "readyPath": "/",
    "startupTimeoutMs": 30000
  },
  "viewports": [
    { "id": "desktop-window", "width": 1440, "height": 900 },
    { "id": "fullscreen-layout", "width": 1920, "height": 1080 }
  ],
  "pages": [
    {
      "id": "kit-demo",
      "path": "/?demo=lab",
      "computedStyles": [
        {
          "selector": ".kit-topbar .rk-button",
          "property": "font-weight",
          "equals": "650"
        },
        {
          "selector": ".kit-topbar .rk-button",
          "property": "border-radius",
          "equals": "10px"
        }
      ],
      "states": [
        {
          "id": "component-lab"
        },
        {
          "id": "component-lab-nav",
          "actions": [
            {
              "type": "click",
              "selector": "[data-step-id='evidence']"
            }
          ]
        },
        {
          "id": "component-lab-reading-drawer",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"Open reading Drawer\"]"
            }
          ]
        },
        {
          "id": "lwf-opening",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            }
          ]
        },
        {
          "id": "lwf-step-update",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "click",
              "selector": ".kit-lwf-panel [data-step-id='update']"
            }
          ]
        },
        {
          "id": "lwf-forward",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#lwf-forward"
            }
          ]
        },
        {
          "id": "lwf-loss",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#lwf-loss"
            }
          ]
        },
        {
          "id": "lwf-update",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#lwf-update"
            }
          ]
        },
        {
          "id": "ewc-warm-hero",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"EWC scenario\"]"
            }
          ]
        },
        {
          "id": "ewc-warm-task-a",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"EWC scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#ewc-task-a"
            }
          ]
        },
        {
          "id": "ewc-warm-importance",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"EWC scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#ewc-importance"
            }
          ]
        }
      ]
    },
    {
      "id": "pattern-gallery",
      "path": "/?demo=gallery",
      "computedStyles": [
        {
          "selector": "#gallery-diagrams .rk-diagram__title",
          "property": "font-size",
          "equals": "15px"
        },
        {
          "selector": ".pattern-gallery__scroll-demo .rk-sticky-system__visual",
          "property": "position",
          "equals": "sticky"
        }
      ],
      "states": [
        { "id": "gallery-opening" },
        {
          "id": "gallery-orthogonal-connectors",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"Orthogonal\"]" }
          ]
        },
        {
          "id": "gallery-reference-focus",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"冻结参考路径\"]" }
          ]
        },
        {
          "id": "gallery-merge",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"汇合 · 两个完整目标\"]" },
            { "type": "click", "selector": "role=button[name=\"任务目标路径\"]" }
          ]
        },
        {
          "id": "gallery-editorial-stagger",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"Staggered rows\"]" },
            { "type": "scrollIntoView", "selector": "#gallery-editorial" }
          ]
        },
        {
          "id": "gallery-sticky-manual",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"Data pipeline\"]" },
            { "type": "click", "selector": ".pattern-gallery__scroll-demo [data-step-id=\"check\"]" },
            { "type": "scrollIntoView", "selector": "#gallery-scroll" }
          ]
        },
        {
          "id": "gallery-sticky-scroll",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"Data pipeline\"]" },
            { "type": "scrollIntoView", "selector": "[data-scroll-step=\"report\"]" }
          ]
        },
        {
          "id": "gallery-formula-terms",
          "actions": [
            { "type": "click", "selector": ".pattern-gallery__type-preview .rk-formula-term:first-child" },
            { "type": "scrollIntoView", "selector": "#gallery-typography" }
          ]
        },
        {
          "id": "gallery-mini-network-full",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#gallery-mini-network [data-network-example=\"local\"]"
            }
          ]
        },
        {
          "id": "gallery-mini-network-focus",
          "actions": [
            {
              "type": "click",
              "selector": "#gallery-mini-network [data-network-example=\"local\"] button"
            },
            {
              "type": "scrollIntoView",
              "selector": "#gallery-mini-network [data-network-example=\"local\"]"
            }
          ]
        },
        {
          "id": "gallery-mini-network-parallel",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#gallery-mini-network [data-network-example=\"parallel\"]"
            }
          ]
        },
        {
          "id": "gallery-timeline-start",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "[data-timeline-example=\"forward\"]"
            }
          ]
        },
        {
          "id": "gallery-timeline-extractor",
          "actions": [
            {
              "type": "click",
              "selector": "[data-stage-target=\"extractor\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-timeline-example=\"forward\"]"
            }
          ]
        },
        {
          "id": "gallery-timeline-representation",
          "actions": [
            {
              "type": "click",
              "selector": "[data-stage-target=\"representation\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-timeline-example=\"forward\"]"
            }
          ]
        },
        {
          "id": "gallery-timeline-scores",
          "actions": [
            {
              "type": "click",
              "selector": "[data-stage-target=\"scores\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-timeline-example=\"forward\"]"
            }
          ]
        },
        {
          "id": "gallery-timeline-responses",
          "actions": [
            {
              "type": "click",
              "selector": "[data-stage-target=\"responses\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-timeline-example=\"forward\"]"
            }
          ]
        },
        {
          "id": "gallery-timeline-paused-motion",
          "actions": [
            {
              "type": "click",
              "selector": "[data-stage-target=\"extractor\"]"
            },
            {
              "type": "click",
              "selector": ".pg-forward-controls .pg-replay-control"
            },
            {
              "type": "wait",
              "milliseconds": 450
            },
            {
              "type": "click",
              "selector": ".pg-forward-controls .pg-play-control"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-timeline-example=\"forward\"]"
            }
          ]
        }
      ]
    },
    {
      "id": "editorial-studies",
      "path": "/?demo=editorial",
      "computedStyles": [
        {
          "selector": ".ed-study__emphasis",
          "property": "font-size",
          "equals": "19.38px"
        },
        {
          "selector": ".ed-study .ed-study__stage-control .rk-step-nav__button",
          "property": "align-items",
          "equals": "center"
        },
        {
          "selector": ".ed-study .ed-study__stage-control .rk-step-nav__button",
          "property": "text-align",
          "equals": "left"
        }
      ],
      "states": [
        {
          "id": "ed-a-default",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#ed-a"
            }
          ]
        },
        {
          "id": "ed-b-learn-a",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#ed-b"
            }
          ]
        },
        {
          "id": "ed-b-estimate",
          "actions": [
            {
              "type": "click",
              "selector": "#ed-b [data-step-id='estimate']"
            },
            {
              "type": "scrollIntoView",
              "selector": "#ed-b"
            }
          ]
        },
        {
          "id": "ed-b-use-b",
          "actions": [
            {
              "type": "click",
              "selector": "#ed-b [data-step-id='use-b']"
            },
            {
              "type": "scrollIntoView",
              "selector": "#ed-b"
            }
          ]
        },
        {
          "id": "ed-c-default",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#ed-c"
            }
          ]
        }
      ]
    },
    {
      "id": "editorial-c1",
      "path": "/?demo=editorial&c=c1",
      "computedStyles": [
        {
          "selector": ".ed-c-candidate[data-c-variant=\"c1\"] [data-equation=\"objective\"]",
          "property": "font-size",
          "equals": "25px"
        }
      ],
      "states": [
        {
          "id": "c1-default",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#ed-c"
            }
          ]
        }
      ]
    },
    {
      "id": "editorial-c2",
      "path": "/?demo=editorial&c=c2",
      "computedStyles": [
        {
          "selector": ".ed-c-candidate[data-c-variant=\"c2\"] [data-equation=\"objective\"]",
          "property": "font-size",
          "equals": "25px"
        }
      ],
      "states": [
        {
          "id": "c2-default",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#ed-c"
            }
          ]
        }
      ]
    },
    {
      "id": "editorial-journey",
      "path": "/?demo=journey",
      "computedStyles": [
        {
          "selector": ".journey .rk-diagram__title",
          "property": "font-size",
          "equals": "15px"
        }
      ],
      "states": [
        {
          "id": "opening"
        },
        {
          "id": "system-overview",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#journey-map"
            }
          ]
        },
        {
          "id": "system-comparisons",
          "actions": [
            {
              "type": "click",
              "selector": ".journey [data-step-id=\"loss\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#journey-map"
            }
          ]
        },
        {
          "id": "local-mechanism",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#journey-paths"
            }
          ]
        },
        {
          "id": "student-optimization",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#journey-student"
            }
          ]
        },
        {
          "id": "temperature-detail",
          "actions": [
            { "type": "click", "selector": ".journey-temperature summary" },
            { "type": "scrollIntoView", "selector": ".journey-temperature" }
          ]
        },
        {
          "id": "task-handoff",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#journey-handoff"
            }
          ]
        }
      ]
    },
    {
      "id": "editorial-journey-stage-candidate",
      "path": "/?demo=journey&art=stage",
      "states": [
        { "id": "stage-overview" },
        { "id": "stage-02-map", "actions": [{ "type": "scrollIntoView", "selector": "#journey-map" }] },
        { "id": "stage-02-to-03", "actions": [{ "type": "scrollIntoView", "selector": "#journey-paths" }] },
        { "id": "stage-03-to-04", "actions": [{ "type": "scrollIntoView", "selector": "#journey-student" }] }
      ]
    },
    {
      "id": "editorial-journey-reveal-candidate",
      "path": "/?demo=journey&art=reveal",
      "states": [
        { "id": "reveal-overview" },
        { "id": "reveal-02-map", "actions": [{ "type": "scrollIntoView", "selector": "#journey-map" }] },
        { "id": "reveal-02-to-03", "actions": [{ "type": "scrollIntoView", "selector": "#journey-paths" }] },
        { "id": "reveal-03-to-04", "actions": [{ "type": "scrollIntoView", "selector": "#journey-student" }] }
      ]
    },
    {
      "id": "reference-hub",
      "path": "/?demo=journey",
      "states": [
        {
          "id": "hub-empty",
          "actions": [{ "type": "click", "selector": ".kit-topbar__hub" }]
        },
        {
          "id": "hub-selected",
          "actions": [
            { "type": "click", "selector": ".kit-topbar__hub" },
            { "type": "click", "selector": ".rk-reference-hub__list [data-reference-id='teacher']" }
          ]
        }
      ]
    }
  ],
  "geometry": {
    "checkPageHorizontalOverflow": true,
    "minSemanticFontSizePx": 12,
    "semanticSelectors": [
      "h1",
      "h2",
      "h3",
      "h4",
      "p",
      "li",
      "label",
      "button",
      "input",
      "select",
      ".rk-diagram__title",
      ".rk-diagram__meta",
      ".rk-diagram__badge",
      ".rk-step-nav__label",
      "[data-vqa-semantic]"
    ],
    "clippingSelectors": [
      ".rk-step-nav__label",
      ".kit-lwf-focus__title",
      ".rk-diagram__title",
      ".rk-diagram__meta",
      ".rk-diagram__badge",
      ".rk-diagram__list-inputs",
      ".kit-lwf__lane p",
      ".ed-study__emphasis",
      ".ed-study__moment-copy h3",
      ".ed-study__phase-label",
      ".ed-study__signal strong",
      ".ed-study math",
      ".ed-c-candidate h3",
      ".ed-c-candidate h4",
      ".ed-c-candidate [data-loss-result]",
      ".journey h1",
      ".journey h2",
      ".journey math",
      ".journey-comparison p",
      ".pattern-gallery__facts dd",
      ".pattern-gallery__editorial h4",
      ".pattern-gallery__scroll-step h3",
      ".pg-overview figure span"
    ]
  },
  "settleMs": 200
}
