{
  "baseUrl": "http://127.0.0.1:4175",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "bundle",
      "--host",
      "127.0.0.1",
      "--port",
      "4175",
      "--strictPort"
    ],
    "cwd": "../../../reusable-kit/demo",
    "readyPath": "/",
    "startupTimeoutMs": 30000
  },
  "viewports": [
    {
      "width": 1280,
      "height": 900
    },
    {
      "width": 1440,
      "height": 900
    },
    {
      "width": 1920,
      "height": 1080
    }
  ],
  "pages": [
    {
      "id": "kit-demo",
      "path": "/",
      "computedStyles": [
        {
          "selector": ".kit-topbar .rk-button",
          "property": "font-weight",
          "equals": "650"
        },
        {
          "selector": ".kit-topbar .rk-button",
          "property": "border-radius",
          "equals": "10px"
        }
      ],
      "states": [
        {
          "id": "component-lab"
        },
        {
          "id": "component-lab-nav",
          "actions": [
            {
              "type": "click",
              "selector": "[data-step-id='evidence']"
            }
          ]
        },
        {
          "id": "component-lab-reading-drawer",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"Open reading Drawer\"]"
            }
          ]
        },
        {
          "id": "lwf-opening",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            }
          ]
        },
        {
          "id": "lwf-step-update",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "click",
              "selector": ".kit-lwf-panel [data-step-id='update']"
            }
          ]
        },
        {
          "id": "lwf-forward",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#lwf-forward"
            }
          ]
        },
        {
          "id": "lwf-loss",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#lwf-loss"
            }
          ]
        },
        {
          "id": "lwf-update",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"LwF scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#lwf-update"
            }
          ]
        },
        {
          "id": "ewc-warm-hero",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"EWC scenario\"]"
            }
          ]
        },
        {
          "id": "ewc-warm-task-a",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"EWC scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#ewc-task-a"
            }
          ]
        },
        {
          "id": "ewc-warm-importance",
          "actions": [
            {
              "type": "click",
              "selector": "role=button[name=\"EWC scenario\"]"
            },
            {
              "type": "scrollIntoView",
              "selector": "#ewc-importance"
            }
          ]
        }
      ]
    }
  ],
  "geometry": {
    "checkPageHorizontalOverflow": true,
    "minSemanticFontSizePx": 12,
    "semanticSelectors": [
      "h1",
      "h2",
      "h3",
      "h4",
      "p",
      "li",
      "label",
      "button",
      "input",
      "select",
      ".rk-diagram__title",
      ".rk-diagram__meta",
      ".rk-diagram__badge",
      ".rk-step-nav__label",
      "[data-vqa-semantic]"
    ],
    "clippingSelectors": [
      ".rk-step-nav__label",
      ".kit-lwf-focus__title",
      ".rk-diagram__title",
      ".rk-diagram__meta",
      ".rk-diagram__badge",
      ".rk-diagram__list-inputs",
      ".kit-lwf__lane p"
    ]
  },
  "settleMs": 200
}
