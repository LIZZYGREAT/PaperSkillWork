{
  "baseUrl": "http://127.0.0.1:4175",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "bundle",
      "--host",
      "127.0.0.1",
      "--port",
      "4175",
      "--strictPort"
    ],
    "cwd": "../../../reusable-kit/demo",
    "readyPath": "/",
    "startupTimeoutMs": 30000
  },
  "pages": [
    {
      "id": "kit-demo",
      "path": "/",
      "states": [
        { "id": "component-lab" },
        {
          "id": "component-lab-reading-drawer",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"Open reading Drawer\"]" }
          ]
        },
        {
          "id": "lwf-tab",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"LwF scenario\"]" }
          ]
        },
        {
          "id": "lwf-forward-focus",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"LwF scenario\"]" },
            { "type": "scrollIntoView", "selector": "#lwf-forward" }
          ]
        },
        {
          "id": "lwf-loss-focus",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"LwF scenario\"]" },
            { "type": "scrollIntoView", "selector": "#lwf-loss" }
          ]
        },
        {
          "id": "ewc-warm-hero",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" }
          ]
        },
        {
          "id": "ewc-warm-task-a",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "scrollIntoView", "selector": "#ewc-task-a" }
          ]
        },
        {
          "id": "ewc-warm-importance",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "scrollIntoView", "selector": "#ewc-importance" }
          ]
        },
        {
          "id": "ewc-clear-hero",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "click", "selector": "role=button[name=\"Clear Research\"]" }
          ]
        },
        {
          "id": "ewc-clear-task-a",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "click", "selector": "role=button[name=\"Clear Research\"]" },
            { "type": "scrollIntoView", "selector": "#ewc-task-a" }
          ]
        },
        {
          "id": "ewc-clear-importance",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "click", "selector": "role=button[name=\"Clear Research\"]" },
            { "type": "scrollIntoView", "selector": "#ewc-importance" }
          ]
        },
        {
          "id": "ewc-term-hover",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "scrollIntoView", "selector": "#ewc-update" },
            { "type": "click", "selector": ".rk-term-ref[data-term-id=\"fisher\"]" }
          ]
        },
        {
          "id": "ewc-reference-hub",
          "actions": [
            { "type": "click", "selector": "role=button[name=\"EWC scenario\"]" },
            { "type": "scrollIntoView", "selector": "#ewc-update" },
            { "type": "click", "selector": ".rk-term-ref[data-term-id=\"fisher\"]" },
            { "type": "click", "selector": "role=button[name=\"查看完整解释\"]" }
          ]
        }
      ]
    }
  ],
  "geometry": {
    "checkPageHorizontalOverflow": true,
    "minSemanticFontSizePx": 12,
    "clippingSelectors": []
  },
  "settleMs": 200
}
