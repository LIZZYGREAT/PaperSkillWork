{
  "baseUrl": "http://127.0.0.1:4173",
  "server": {
    "command": "node",
    "args": ["node_modules/vite/bin/vite.js", "preview", "--host", "127.0.0.1", "--port", "4173", "--strictPort"],
    "cwd": ".",
    "readyPath": "/"
  },
  "pages": [
    {
      "id": "icarl-home",
      "path": "/",
      "states": [
        {
          "id": "initial",
          "actions": [
            { "type": "waitFor", "selector": ".ewc-rail", "state": "visible" },
            { "type": "waitFor", "selector": "#page-one-title", "state": "visible" }
          ]
        },
        {
          "id": "next-page",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(2)" },
            { "type": "waitFor", "selector": "#page-two-title", "state": "visible" }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ":root", "property": "--nav", "equals": "#183236" },
        { "selector": ".ewc-rail", "property": "background-color", "equals": "rgb(24, 50, 54)" }
      ]
    },
    {
      "id": "icarl-p3-prototype-prediction",
      "path": "/",
      "states": [
        {
          "id": "01-exemplar-features",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(3)" },
            { "type": "waitFor", "selector": ".p3-map--stage-0", "state": "visible" }
          ]
        },
        {
          "id": "02-class-prototypes",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(3)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(2)" },
            { "type": "waitFor", "selector": ".p3-map--stage-1", "state": "visible" }
          ]
        },
        {
          "id": "03-query-feature",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(3)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(3)" },
            { "type": "waitFor", "selector": ".p3-map--stage-2", "state": "visible" }
          ]
        },
        {
          "id": "04-nearest-prototype",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(3)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(4)" },
            { "type": "waitFor", "selector": ".p3-map--stage-3", "state": "visible" }
          ]
        },
        {
          "id": "05-direct-return",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(3)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(4)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(2)" },
            { "type": "waitFor", "selector": ".p3-map--stage-1", "state": "visible" }
          ]
        },
        {
          "id": "06-next-and-back",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(3)" },
            { "type": "click", "selector": ".icarl-guided__controls .icarl-button--primary" },
            { "type": "click", "selector": ".icarl-guided__controls .icarl-button--primary" },
            { "type": "click", "selector": ".icarl-guided__controls .icarl-button--quiet" },
            { "type": "waitFor", "selector": ".p3-map--stage-1", "state": "visible" }
          ]
        }
      ]
    },
    {
      "id": "icarl-p1-to-p5-handoffs",
      "path": "/",
      "states": [
        {
          "id": "p1-problem-to-model",
          "actions": [
            { "type": "click", "selector": ".p1-step-nav__item:nth-child(6)" },
            { "type": "waitFor", "selector": ".p1-problem.is-active", "state": "visible" }
          ]
        },
        {
          "id": "p2-model-to-prototype",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(2)" },
            { "type": "click", "selector": ".p2-action" },
            { "type": "waitFor", "selector": ".p2-handoff", "state": "visible" }
          ]
        },
        {
          "id": "p4-memory-continuity",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(4)" },
            { "type": "waitFor", "selector": ".icarl-page--p4", "state": "visible" }
          ]
        },
        {
          "id": "p4-budget-to-herding",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(4)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(6)" },
            { "type": "waitFor", "selector": ".p4-mean-question", "state": "visible" }
          ]
        },
        {
          "id": "p5-class4-herding",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(5)" },
            { "type": "waitFor", "selector": ".p5-example-note", "state": "visible" }
          ]
        },
        {
          "id": "p5-prefix-to-training",
          "actions": [
            { "type": "click", "selector": ".ewc-slice-nav__item:nth-child(5)" },
            { "type": "click", "selector": ".icarl-guided__step:nth-child(6)" },
            { "type": "waitFor", "selector": ".p5-runtime-order", "state": "visible" }
          ]
        }
      ]
    }
  ],
  "geometry": {
    "checkPageHorizontalOverflow": true,
    "minSemanticFontSizePx": 11
  }
}
