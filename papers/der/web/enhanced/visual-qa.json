{
  "baseUrl": "http://127.0.0.1:4197/der-review/",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "runner",
      "--host",
      "127.0.0.1",
      "--port",
      "4197",
      "--strictPort",
      "--base",
      "/der-review/"
    ],
    "cwd": ".",
    "readyPath": "/der-review/",
    "startupTimeoutMs": 30000
  },
  "viewports": [
    {
      "id": "desktop-window",
      "width": 1440,
      "height": 900
    },
    {
      "id": "fullscreen-layout",
      "width": 1920,
      "height": 1080
    }
  ],
  "pages": [
    {
      "id": "article",
      "path": "./",
      "computedStyles": [
        {
          "selector": ":root",
          "property": "--rk-canvas",
          "equals": "#f7f7f2"
        }
      ],
      "states": [
        {
          "id": "opening"
        },
        {
          "id": "s2",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "[data-design=kl]"
            }
          ]
        },
        {
          "id": "s8",
          "actions": [
            {
              "type": "scrollIntoView",
              "selector": "#U7-evidence-and-limits"
            }
          ]
        }
      ]
    },
    {
      "id": "lifecycle",
      "path": "./?review=1&focus=lifecycle",
      "states": [
        {
          "id": "frozen",
          "actions": [
            {
              "type": "selectOption",
              "selector": "[data-scene=lifecycle] select",
              "value": "2"
            },
            {
              "type": "click",
              "selector": "[data-scene=lifecycle] [data-play]"
            },
            {
              "type": "wait",
              "milliseconds": 3500
            },
            {
              "type": "click",
              "selector": "[data-scene=lifecycle] [data-play]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-scene=lifecycle] svg"
            }
          ]
        },
        {
          "id": "replay",
          "actions": [
            {
              "type": "selectOption",
              "selector": "[data-scene=lifecycle] select",
              "value": "5"
            },
            {
              "type": "click",
              "selector": "[data-scene=lifecycle] [data-play]"
            },
            {
              "type": "wait",
              "milliseconds": 12000
            },
            {
              "type": "click",
              "selector": "[data-scene=lifecycle] [data-play]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-scene=lifecycle] svg"
            }
          ]
        },
        {
          "id": "stored",
          "actions": [
            {
              "type": "selectOption",
              "selector": "[data-scene=lifecycle] select",
              "value": "8"
            },
            {
              "type": "click",
              "selector": "[data-scene=lifecycle] [data-play]"
            },
            {
              "type": "wait",
              "milliseconds": 3700
            },
            {
              "type": "click",
              "selector": "[data-scene=lifecycle] [data-play]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-scene=lifecycle] svg"
            }
          ]
        }
      ]
    },
    {
      "id": "reservoir",
      "path": "./?focus=reservoir",
      "states": [
        {
          "id": "replace-middle",
          "actions": [
            {
              "type": "selectOption",
              "selector": "[data-scene=reservoir] select",
              "value": "2"
            },
            {
              "type": "click",
              "selector": "[data-scene=reservoir] [data-play]"
            },
            {
              "type": "wait",
              "milliseconds": 5500
            },
            {
              "type": "click",
              "selector": "[data-scene=reservoir] [data-play]"
            },
            {
              "type": "scrollIntoView",
              "selector": "[data-scene=reservoir] .rv-canvas"
            }
          ]
        },
        {
          "id": "reject",
          "actions": [
            {
              "type": "selectOption",
              "selector": "[data-scene=reservoir] select",
              "value": "3"
            },
            {
              "type": "click",
              "selector": "[data-scene=reservoir] [data-play]"
            },
            {
              "type": "wait",
              "milliseconds": 7500
            },
            {
              "type": "click",
              "selector": "[data-scene=reservoir] [data-play]"
            },
            {
              "type": "scrollIntoView",
