    {
      "id": "evidence",
      "path": "./?focus=evidence",
      "states": [
        {
          "id": "class-il"
        },
        {
          "id": "task-il",
          "actions": [
            {
              "type": "click",
              "selector": "[data-experiment-select='1']"
            }
          ]
        },
        {
          "id": "mnist200",
          "actions": [
            {
              "type": "click",
              "selector": "[data-experiment-select='3']"
            }
          ]
        }
      ]
