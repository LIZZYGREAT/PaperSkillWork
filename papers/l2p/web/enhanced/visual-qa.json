        {
          "id": "ranking",
          "actions": [{ "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(4)" }]
        },
        { "id": "read-view", "actions": [{ "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(5)" }] },
        {
          "id": "query-b-read-view",
          "actions": [
            { "type": "click", "selector": ".p5-query-controls button:has-text('查询 B')" },
            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(5)" }
          ]
        },
        {
          "id": "query-b-comparison",
          "actions": [
            { "type": "click", "selector": ".p5-query-controls button:has-text('查询 B')" },
            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(6)" }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" },
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p5-motion-controls", "property": "position", "equals": "sticky" },
        { "selector": ".p5-retrieval-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p5-query-direction > line", "property": "stroke-width", "equals": "1.8px" }
      ]
    },
    {
      "id": "p6",
