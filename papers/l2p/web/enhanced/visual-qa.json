            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(3)" },
            { "type": "click", "selector": "button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 500 },
            { "type": "click", "selector": "button:has-text('暂停')" }
