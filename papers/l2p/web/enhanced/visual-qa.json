{
  "baseUrl": "http://127.0.0.1:4174",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--host",
      "127.0.0.1",
      "--port",
      "4174",
      "--strictPort"
    ],
    "cwd": ".",
    "readyPath": "/"
  },
  "pages": [
    {
      "id": "p4",
      "path": "/?page=p4",
      "states": [
        { "id": "initial" },
        { "id": "loss-calculation", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(3)" }] },
        { "id": "gradient-flow", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(4)" }] },
        { "id": "prompt-update", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(5)" }] },
        { "id": "update-intermediate", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(5)" }, { "type": "click", "selector": ".p4-control-dock button:has-text('播放过程')" }, { "type": "wait", "milliseconds": 725 }, { "type": "click", "selector": ".p4-control-dock button:has-text('暂停')" }] },
        { "id": "same-image-reforward", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(6)" }] },
        { "id": "next-task", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(7)" }] }
      ],
      "computedStyles": [
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p4-control-dock", "property": "position", "equals": "sticky" },
        { "selector": ".lesson-figure.p4-training-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p4-gradient-line", "property": "stroke-width", "equals": "1.7px" }
      ]
    },
    {
      "id": "p5-query-a",
      "path": "/?page=p5",
      "states": [
        { "id": "query" },
        {
          "id": "key-angle-example",
          "actions": [{ "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(2)" }]
        },
        {
          "id": "orbit-k1-to-k2",
          "actions": [
            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(3)" },
            { "type": "click", "selector": "button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 500 },
            { "type": "click", "selector": "button:has-text('暂停')" }
          ]
        },
        {
          "id": "orbit-k3-angle",
          "actions": [
            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(3)" },
            { "type": "click", "selector": "button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 1600 },
            { "type": "click", "selector": "button:has-text('暂停')" },
            { "type": "scrollIntoView", "selector": ".p5-vector-space" }
          ]
        },
        {
          "id": "ranking",
          "actions": [{ "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(4)" }]
        },
        { "id": "read-view", "actions": [{ "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(5)" }] },
        {
          "id": "query-b-read-view",
          "actions": [
            { "type": "click", "selector": ".p5-query-controls button:has-text('查询 B')" },
            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(5)" }
          ]
        },
        {
          "id": "query-b-comparison",
          "actions": [
            { "type": "click", "selector": ".p5-query-controls button:has-text('查询 B')" },
            { "type": "click", "selector": ".p5-motion-controls .motion-stops button:nth-child(6)" }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p5-motion-controls", "property": "position", "equals": "sticky" },
        { "selector": ".p5-retrieval-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p5-query-direction > line", "property": "stroke-width", "equals": "1.8px" }
      ]
    },
    {
      "id": "p6",
      "path": "/?page=p6",
      "states": [
        { "id": "selected-prompt-pool" },
        { "id": "compose-sequence", "actions": [{ "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(3)" }] },
        {
          "id": "compose-flight-midpoint",
          "actions": [
            { "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(3)" },
            { "type": "click", "selector": ".p6-control-dock button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 650 },
            { "type": "click", "selector": ".p6-control-dock button:has-text('暂停')" },
            { "type": "scrollIntoView", "selector": ".p6-sequence-workbench" }
          ]
        },
        {
          "id": "prompt-position-map",
          "actions": [
            { "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(3)" },
            { "type": "click", "selector": ".p6-sequence-cell[data-sequence-index='12']" }
          ]
        },
        { "id": "frozen-encoder", "actions": [{ "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(4)" }] },
        {
          "id": "encoder-flight-midpoint",
          "actions": [
            { "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(4)" },
            { "type": "click", "selector": ".p6-control-dock button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 700 },
            { "type": "click", "selector": ".p6-control-dock button:has-text('暂停')" },
            { "type": "scrollIntoView", "selector": ".p6-encoder-stage" }
          ]
        },
        { "id": "prompt-position-pooling", "actions": [{ "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(5)" }] },
        {
          "id": "pool-intermediate",
          "actions": [
            { "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(5)" },
            { "type": "click", "selector": ".p6-control-dock button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 775 },
            { "type": "click", "selector": ".p6-control-dock button:has-text('暂停')" },
            { "type": "scrollIntoView", "selector": ".p6-pooling-workbench" }
          ]
        },
        { "id": "class-logits", "actions": [{ "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(6)" }] }
      ],
      "computedStyles": [
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p6-control-dock", "property": "position", "equals": "sticky" },
        { "selector": ".lesson-figure.p6-forward-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p6-encoder-lane-line", "property": "height", "equals": "1px" }
      ]
    }
  ],
  "geometry": {
    "checkPageHorizontalOverflow": true,
    "minSemanticFontSizePx": 12
  }
}
