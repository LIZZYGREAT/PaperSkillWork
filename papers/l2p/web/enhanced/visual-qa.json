{
  "baseUrl": "http://127.0.0.1:4174",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "runner",
      "--host",
      "127.0.0.1",
      "--port",
      "4174",
      "--strictPort"
    ],
    "cwd": ".",
    "readyPath": "/"
  },
  "pages": [
    {
      "id": "p1",
      "path": "/?page=p1",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "snapshot2",
          "actions": [
            {
              "type": "click",
              "selector": ".task-rail button:nth-child(2)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p2",
      "path": "/?page=p2",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "patch196",
          "actions": [
            {
              "type": "press",
              "selector": "#patch-index",
              "key": "End"
            },
            {
              "type": "click",
              "selector": ".patch-motion .motion-stops button:nth-child(4)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p3",
