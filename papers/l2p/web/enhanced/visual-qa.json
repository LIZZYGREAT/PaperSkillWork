{
  "baseUrl": "http://127.0.0.1:4174",
  "server": {
    "command": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "preview",
      "--configLoader",
      "runner",
      "--host",
      "127.0.0.1",
      "--port",
      "4174",
      "--strictPort"
    ],
    "cwd": ".",
    "readyPath": "/"
  },
  "pages": [
    {
      "id": "p1",
      "path": "/?page=p1",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "snapshot2",
          "actions": [
            {
              "type": "click",
              "selector": ".task-rail button:nth-child(2)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p2",
      "path": "/?page=p2",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "patch196",
          "actions": [
            {
              "type": "press",
              "selector": "#patch-index",
              "key": "End"
            },
            {
              "type": "click",
              "selector": ".patch-motion .motion-stops button:nth-child(4)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p3",
      "path": "/?page=p3",
      "states": [
        {
          "id": "initial"
        },
        {
          "id": "extra",
          "actions": [
            {
              "type": "click",
              "selector": ".attention-controls input"
            }
          ]
        },
        {
          "id": "head-output",
          "actions": [
            {
              "type": "click",
              "selector": ".head-animation .motion-stops button:nth-child(4)"
            }
          ]
        }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" }
      ]
    },
    {
      "id": "p4",
      "path": "/?page=p4",
      "states": [
        { "id": "initial" },
        { "id": "loss-calculation", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(3)" }] },
        { "id": "gradient-flow", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(4)" }] },
        { "id": "prompt-update", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(5)" }] },
        { "id": "update-intermediate", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(5)" }, { "type": "click", "selector": ".p4-control-dock button:has-text('播放过程')" }, { "type": "wait", "milliseconds": 725 }, { "type": "click", "selector": ".p4-control-dock button:has-text('暂停')" }] },
        { "id": "same-image-reforward", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(6)" }] },
        { "id": "next-task", "actions": [{ "type": "click", "selector": ".p4-control-dock .motion-stops button:nth-child(7)" }] }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" },
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p4-control-dock", "property": "position", "equals": "sticky" },
        { "selector": ".lesson-figure.p4-training-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p4-gradient-line", "property": "stroke-width", "equals": "1.7px" }
      ]
    },
    {
      "id": "p5-query-a",
      "path": "/?page=p5",
