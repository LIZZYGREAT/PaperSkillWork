        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p7-control-dock", "property": "position", "equals": "sticky" },
        { "selector": ".lesson-figure.p7-batch-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p7-slot-chip[data-parameter-kind='prompt'][data-slot-index='3']", "property": "border-top-width", "equals": "2px" }
      ]
    },
    {
      "id": "p8",
      "path": "/?page=p8",
