            { "type": "click", "selector": ".p6-control-dock button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 700 },
            { "type": "click", "selector": ".p6-control-dock button:has-text('暂停')" },
            { "type": "scrollIntoView", "selector": ".p6-encoder-stage" }
          ]
        },
        { "id": "prompt-position-pooling", "actions": [{ "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(5)" }] },
        {
          "id": "pool-intermediate",
          "actions": [
            { "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(5)" },
            { "type": "click", "selector": ".p6-control-dock button:has-text('播放过程')" },
            { "type": "wait", "milliseconds": 775 },
            { "type": "click", "selector": ".p6-control-dock button:has-text('暂停')" },
            { "type": "scrollIntoView", "selector": ".p6-pooling-workbench" }
          ]
        },
        { "id": "class-logits", "actions": [{ "type": "click", "selector": ".p6-control-dock .motion-stops button:nth-child(6)" }] }
      ],
      "computedStyles": [
        { "selector": ".lesson-copy", "property": "--lesson-body-size", "equals": "17px" },
        { "selector": ":root", "property": "--rk-canvas", "equals": "#f7f7f2" },
        { "selector": ".p6-control-dock", "property": "position", "equals": "sticky" },
        { "selector": ".lesson-figure.p6-forward-figure", "property": "overflow", "equals": "clip" },
        { "selector": ".p6-encoder-lane-line", "property": "height", "equals": "1px" }
